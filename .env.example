# Copy sang .env rồi sửa nếu cần. Key nào bỏ trống thì lấy default trong app/core/config.py.

APP_NAME=TaskHub
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Bắt buộc. Postgres chạy bằng docker compose, host port 5433.
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5433/taskhub

# Bắt buộc, tối thiểu 32 bytes. Đổi khi deploy thật, đừng commit giá trị thật.
SECRET_KEY=local-dev-secret-key-change-me-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
