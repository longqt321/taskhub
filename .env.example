# Copy this file to `.env` and adjust values as needed.
# All keys are optional for local development; defaults are defined in app/core/config.py.

APP_NAME=TaskHub
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Used from Day 2 (database) and Day 5 (caching); validated at startup.
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
REDIS_URL=redis://localhost:6379/0
