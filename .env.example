# Copy sang .env rồi sửa nếu cần. Key nào bỏ trống thì lấy default trong app/core/config.py.

APP_NAME=TaskHub
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Postgres chạy bằng docker compose, host port 5433 để không đụng Postgres khác trên máy.
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5433/taskhub

# Chưa dùng, để dành cho Day 5.
REDIS_URL=redis://localhost:6379/0
