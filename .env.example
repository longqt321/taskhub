# Copy sang .env rồi sửa nếu cần. Key nào bỏ trống thì lấy default trong app/core/config.py.

APP_NAME=TaskHub
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Chưa dùng ở Day 1, khai báo sẵn cho Day 2 (DB) và Day 5 (cache).
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5433/taskhub
REDIS_URL=redis://localhost:6379/0
